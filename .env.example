# ── Required ──────────────────────────────────────────────
JWT_SECRET=change-me-to-a-strong-random-secret

LINE_PAY_CHANNEL_ID=your-line-pay-channel-id
LINE_PAY_CHANNEL_SECRET=your-line-pay-channel-secret

# ── Optional (defaults shown) ──────────────────────────────
JWT_EXPIRES_IN=1d

# Comma-separated list of allowed frontend origins
CLIENT_ORIGIN=http://localhost:5173

LINE_PAY_API_BASE_URL=https://sandbox-api-pay.line.me
LINE_PAY_CONFIRM_URL=http://localhost:5173/payments/line-pay/confirm
LINE_PAY_CANCEL_URL=http://localhost:5173/payments/line-pay/cancel

# Web Push (generate with: npx web-push generate-vapid-keys)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_EMAIL=admin@example.com

# Frontend build args (used by docker-compose)
VITE_API_BASE_URL=http://localhost:3000/api
VITE_SOCKET_URL=http://localhost:3000
